# Database
DATABASE_URL=postgresql+asyncpg://app:secret@localhost:5432/partner_cabinet
DB_PASSWORD=secret

# Redis (также используется Celery как broker)
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=partner-cabinet

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Окружение: development | staging | production
# В production/staging обязательно выставить: SECRET_KEY, DB_PASSWORD, S3_* (без дефолтов),
# COOKIE_SECURE=true, ALLOWED_HOSTS с реальным доменом.
ENVIRONMENT=development

# Cookie (refresh-token): на проде с HTTPS обязательно COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Разрешённые Host-заголовки (TrustedHostMiddleware, только в production/staging).
# Включайте "localhost" и "127.0.0.1" — они нужны для docker healthcheck и on-host curl.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Logging
LOG_LEVEL=INFO

# Нейропомощник (фаза 4, опционально)
OPENAI_API_KEY=

# YooKassa (платежи). Тестовый магазин — оставьте пустым в проде, иначе платежи будут идти в тестовый стенд.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/dashboard/finance/court-fees

# Yandex SmartCaptcha (регистрация партнёра). Пусто = проверка выключена.
# Серверный ключ — только на backend; клиентский — в VITE_* ниже.
YANDEX_CAPTCHA_SECRET_KEY=

# Восстановление пароля. Для Яндекс.Почты обычно: smtp.yandex.ru, 465, SSL=true.
PUBLIC_APP_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
PASSWORD_RESET_EXPIRE_MINUTES=30

# Битрикс24 — только для технического обследования (этап 1).
# Значения приходят в auth-объекте callback локального OAuth-приложения.
# Токен не коммитить и не вставлять в переписку.
BITRIX_CLIENT_ENDPOINT=
BITRIX_ACCESS_TOKEN=
# Код и ключ локального приложения. Нужны для автоматического обновления OAuth-токенов.
# Хранить только в серверном .env, не коммитить реальные значения.
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_SMART_PROCESS_ENTITY_TYPE_ID=1070
# Клиенты уже в суде: воронка «АРБИТРАЖ».
BITRIX_DEAL_CATEGORY_ID=3
# Клиенты до суда: воронка «Отдел сопровождения».
BITRIX_SUPPORT_DEAL_CATEGORY_ID=7
BITRIX_ALLOWED_DOMAIN=bitrix.uriteh.ru
# Сотрудники ЮРИТЕХ, которых бот добавляет в автоматически создаваемые чаты поддержки.
BITRIX_CHAT_SUPPORT_USER_IDS=[]
# За один цикл создаётся не более указанного количества чатов.
BITRIX_CHAT_PROVISION_BATCH_SIZE=25
# Партнёры, для которых чат создавать нельзя. Проверяются ФИО и названия организации.
BITRIX_CHAT_EXCLUDED_PARTNER_TERMS='["агейчик","протацкая","ифнс","федеральная налоговая служба","косточкина"]'
# Отдельная случайная строка (минимум 32 символа) для pgcrypto-шифрования OAuth-токенов в БД.
# Не должна совпадать с SECRET_KEY.
BITRIX_TOKEN_ENCRYPTION_KEY=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_YANDEX_CAPTCHA_CLIENT_KEY=
